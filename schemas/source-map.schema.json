{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/eastwind/translation-toolkit/raw/branch/main/schemas/source-map.schema.json",
  "title": "MPI media source-to-timestamp map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "media_sha256", "segments"],
  "properties": {
    "schema_version": {"const": 1},
    "media_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "source_line"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "source_line": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
