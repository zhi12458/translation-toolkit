{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/eastwind/translation-toolkit/raw/branch/main/schemas/source-analysis.schema.json",
  "title": "MPI blind Chinese source semantic analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "source_sha256",
    "project_sha256",
    "term_map_sha256",
    "provider",
    "model",
    "configuration",
    "generated_at",
    "paragraphs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "title",
        "source_origin",
        "delivery_format",
        "external_semantic_review"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "title": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "source_origin": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "delivery_format": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "external_semantic_review": {
          "anyOf": [
            {"type": "string", "enum": ["allow", "deny"]},
            {"type": "null"}
          ]
        }
      }
    },
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "term_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Provider provenance, such as moonshot, qwencloud, or internal."
    },
    "model": {"type": "string", "minLength": 1},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "reasoning_effort",
        "response_format",
        "strict",
        "serial",
        "batch_size",
        "request_count",
        "timeout_seconds",
        "max_completion_tokens",
        "rate_limit_tier",
        "rate_limit_concurrency",
        "rate_limit_rpm",
        "rate_limit_tpm"
      ],
      "properties": {
        "base_url": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "enum": ["disabled", "high", "max"]},
        "response_format": {"type": "string", "enum": ["json_schema", "json_object"]},
        "strict": {"type": "boolean"},
        "serial": {"type": "boolean", "const": true},
        "batch_size": {"type": "integer", "minimum": 1},
        "request_count": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_completion_tokens": {
          "description": "Requested completion cap, or null when the provider requires it to be omitted for structured output.",
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "rate_limit_tier": {
          "description": "External-provider tier, or null for an internal analysis role.",
          "anyOf": [
            {"type": "string", "enum": ["Tier1"]},
            {"type": "null"}
          ]
        },
        "rate_limit_concurrency": {
          "description": "Effective external-provider concurrency, or null for an internal role.",
          "anyOf": [
            {"type": "integer", "const": 1},
            {"type": "null"}
          ]
        },
        "rate_limit_rpm": {
          "description": "External-provider requests-per-minute limit, or null for an internal role.",
          "anyOf": [
            {"type": "integer", "const": 200},
            {"type": "null"}
          ]
        },
        "rate_limit_tpm": {
          "description": "External-provider tokens-per-minute limit, or null for an internal role.",
          "anyOf": [
            {"type": "integer", "const": 2000000},
            {"type": "null"}
          ]
        },
        "context_mode": {
          "type": "string",
          "enum": ["serial-local-window-with-full-coverage"]
        },
        "context_window_paragraphs": {"type": "integer", "minimum": 0},
        "retry_limit": {"type": "integer", "minimum": 0},
        "component_mode": {"type": "string", "enum": ["seven-pass-merge"]},
        "component_fallback_mode": {
          "type": "string",
          "enum": ["single-paragraph-after-batch-retries"]
        },
        "completion_recovery_mode": {
          "type": "string",
          "enum": ["omit-max-completion-tokens-after-empty-or-length"]
        },
        "transient_batch_recovery_mode": {
          "type": "string",
          "enum": ["retry-same-batch-after-exhausted-transient-component"]
        },
        "transient_batch_retry_limit": {
          "type": "integer",
          "minimum": 0
        },
        "cross_component_reconciliation_mode": {
          "type": "string",
          "enum": ["union-validated-temporal-markers-into-must-preserve"]
        },
        "component_evidence_prevalidation_mode": {
          "type": "string",
          "enum": ["verbatim-source-evidence-before-component-acceptance"]
        },
        "analysis_components": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "core",
              "temporal",
              "operator_negation_modality",
              "operator_quantity_degree",
              "operator_tense_aspect_other",
              "reference",
              "constraints"
            ]
          }
        },
        "component_context_windows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core",
            "temporal",
            "operator_negation_modality",
            "operator_quantity_degree",
            "operator_tense_aspect_other",
            "reference",
            "constraints"
          ],
          "properties": {
            "core": {"type": "integer", "const": 1},
            "temporal": {"type": "integer", "const": 0},
            "operator_negation_modality": {"type": "integer", "const": 0},
            "operator_quantity_degree": {"type": "integer", "const": 0},
            "operator_tense_aspect_other": {"type": "integer", "const": 0},
            "reference": {"type": "integer", "const": 3},
            "constraints": {"type": "integer", "const": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"response_format": {"const": "json_schema"}}},
          "then": {"properties": {"strict": {"const": true}}}
        },
        {
          "if": {"properties": {"response_format": {"const": "json_object"}}},
          "then": {"properties": {"strict": {"const": false}}}
        }
      ]
    },
    "generated_at": {"type": "string", "minLength": 1},
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_id",
          "predicates",
          "relations",
          "temporal_relations",
          "operators",
          "references_and_ellipsis",
          "elliptical_subject",
          "cultural_allusions",
          "competing_interpretations",
          "must_preserve",
          "must_not_invent",
          "status"
        ],
        "properties": {
          "paragraph_id": {"type": "string", "minLength": 1},
          "predicates": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["predicate", "canonical_meaning", "evidence", "participants"],
              "properties": {
                "predicate": {"type": "string", "minLength": 1, "maxLength": 40},
                "canonical_meaning": {"type": "string", "minLength": 1, "maxLength": 120},
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "必须是当前段落中连续逐字出现的谓词证据，不得改写或概括。"
                },
                "participants": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["role", "participant", "evidence", "evidence_status", "notes"],
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "agent",
                          "experiencer",
                          "patient",
                          "theme",
                          "beneficiary",
                          "recipient",
                          "instrument",
                          "cause",
                          "state_holder",
                          "stimulus",
                          "causer",
                          "source",
                          "goal",
                          "location",
                          "other"
                        ]
                      },
                      "participant": {
                        "description": "explicit 时必须是当前段落中连续逐字出现的短语；省略或不确定时填 null，依证据标 contextual_inference 或 ambiguous，不得填概括性人物。",
                        "anyOf": [
                          {"type": "string", "minLength": 1, "maxLength": 100},
                          {"type": "null"}
                        ]
                      },
                      "evidence": {
                        "description": "连续逐字复制原文证据；explicit 时必须来自当前段落并包含 participant。",
                        "anyOf": [
                          {"type": "string", "minLength": 1, "maxLength": 100},
                          {"type": "null"}
                        ]
                      },
                      "evidence_status": {
                        "type": "string",
                        "enum": ["explicit", "contextual_inference", "ambiguous"],
                        "description": "explicit 仅用于当前段落逐字明示的角色；承前主语用 contextual_inference；无法确定用 ambiguous。"
                      },
                      "notes": {"type": "string", "maxLength": 120}
                    }
                  }
                }
              }
            }
          },
          "relations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "source_clause",
                "target_clause",
                "evidence",
                "evidence_status",
                "notes"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "purpose",
                    "cause",
                    "condition",
                    "result",
                    "contrast",
                    "progression",
                    "cost",
                    "concession",
                    "coordination",
                    "temporal",
                    "other"
                  ]
                },
                "source_clause": {"type": "string", "minLength": 1, "maxLength": 120},
                "target_clause": {"type": "string", "minLength": 1, "maxLength": 120},
                "evidence": {
                  "description": "非 null 时必须是当前段落中连续逐字出现的关系证据。",
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 160},
                    {"type": "null"}
                  ]
                },
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"]
                },
                "notes": {"type": "string", "maxLength": 120}
              }
            }
          },
          "temporal_relations": {
            "type": "array",
            "maxItems": 12,
            "description": "单列所有会约束译文的时间先后、时点、持续、完成、重复和才/仍/再等时体关系。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "marker",
                "relation",
                "event_or_scope",
                "linked_event",
                "evidence_status",
                "notes"
              ],
              "properties": {
                "marker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "description": "必须是当前段落中连续逐字出现的时间或时体标记。"
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "when",
                    "before",
                    "after",
                    "sequence",
                    "continuation",
                    "repetition",
                    "completion",
                    "only_then",
                    "other"
                  ]
                },
                "event_or_scope": {"type": "string", "minLength": 1, "maxLength": 120},
                "linked_event": {
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 120},
                    {"type": "null"}
                  ]
                },
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"]
                },
                "notes": {"type": "string", "maxLength": 120}
              }
            }
          },
          "operators": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "marker",
                "scope",
                "interpretation",
                "evidence_status",
                "notes"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["tense", "aspect", "modality", "negation", "quantity", "degree", "other"]
                },
                "marker": {
                  "description": "非 null 时必须是当前段落中连续逐字出现的作用域标记；无逐字标记时填 null，不得概括。",
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 40},
                    {"type": "null"}
                  ]
                },
                "scope": {"type": "string", "minLength": 1, "maxLength": 120},
                "interpretation": {"type": "string", "minLength": 1, "maxLength": 120},
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"]
                },
                "notes": {"type": "string", "maxLength": 120}
              }
            }
          },
          "references_and_ellipsis": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expression",
                "predicate",
                "role",
                "referent",
                "candidate_referents",
                "evidence",
                "evidence_status",
                "notes"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["coreference", "omitted_subject", "omitted_object", "inherited_subject", "ambiguous_reference", "other"]
                },
                "expression": {
                  "description": "非 null 时必须是当前段落中连续逐字出现的指代或省略表达。",
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 80},
                    {"type": "null"}
                  ]
                },
                "predicate": {
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 40},
                    {"type": "null"}
                  ]
                },
                "role": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "agent",
                        "experiencer",
                        "patient",
                        "theme",
                        "beneficiary",
                        "recipient",
                        "instrument",
                        "cause",
                        "state_holder",
                        "stimulus",
                        "causer",
                        "source",
                        "goal",
                        "location",
                        "other"
                      ]
                    },
                    {"type": "null"}
                  ]
                },
                "referent": {
                  "description": "若为 null，evidence_status 只能是 contextual_inference 或 ambiguous，绝不能是 explicit。",
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 120},
                    {"type": "null"}
                  ]
                },
                "candidate_referents": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"type": "string", "minLength": 1, "maxLength": 120}
                },
                "evidence": {
                  "description": "非 null 时必须是中文全文中连续逐字出现的指代证据。",
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 160},
                    {"type": "null"}
                  ]
                },
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"],
                  "description": "explicit 要求 referent 非 null 且有逐字证据；null 只能标 contextual_inference 或 ambiguous。"
                },
                "notes": {"type": "string", "maxLength": 120}
              }
            }
          },
          "elliptical_subject": {
            "type": "array",
            "maxItems": 8,
            "description": "单列佛法格言、文言压缩句和省略句的隐含主语，并把施事者、原因、工具、状态承担者分开。无此现象时为空数组。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clause",
                "predicate",
                "subject_resolution",
                "subject_evidence",
                "role_bindings",
                "evidence_status",
                "notes"
              ],
              "properties": {
                "clause": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "description": "必须是当前段落中连续逐字出现的压缩句或省略句。"
                },
                "predicate": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "description": "必须是 clause 中连续逐字出现的谓词。"
                },
                "subject_resolution": {
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 120},
                    {"type": "null"}
                  ]
                },
                "subject_evidence": {
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 160},
                    {"type": "null"}
                  ],
                  "description": "非 null 时必须是中文全文中连续逐字出现的主语判断依据。"
                },
                "role_bindings": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["role", "participant", "evidence", "evidence_status", "notes"],
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": ["agent", "cause", "instrument", "state_holder"]
                      },
                      "participant": {
                        "anyOf": [
                          {"type": "string", "minLength": 1, "maxLength": 120},
                          {"type": "null"}
                        ]
                      },
                      "evidence": {
                        "anyOf": [
                          {"type": "string", "minLength": 1, "maxLength": 160},
                          {"type": "null"}
                        ]
                      },
                      "evidence_status": {
                        "type": "string",
                        "enum": ["explicit", "contextual_inference", "ambiguous"]
                      },
                      "notes": {"type": "string", "maxLength": 120}
                    }
                  }
                },
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"]
                },
                "notes": {"type": "string", "maxLength": 160}
              }
            }
          },
          "cultural_allusions": {
            "type": "array",
            "maxItems": 12,
            "description": "单列成语、格言、典故、经论引语、文言固定结构和历史文化指涉。无此现象时为空数组；不得因术语表已有候选译法而省略。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expression",
                "kind",
                "source_or_origin",
                "contextual_meaning",
                "competing_senses",
                "translation_constraint",
                "research_trigger",
                "external_research_required",
                "evidence_status",
                "notes"
              ],
              "properties": {
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "必须是当前段落中连续逐字出现的文化表达。"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "idiom",
                    "proverb",
                    "classical_quotation",
                    "canonical_allusion",
                    "scriptural_quotation",
                    "historical_reference",
                    "fixed_classical_expression",
                    "other"
                  ]
                },
                "source_or_origin": {
                  "anyOf": [
                    {"type": "string", "minLength": 1, "maxLength": 120},
                    {"type": "null"}
                  ]
                },
                "contextual_meaning": {"type": "string", "minLength": 1, "maxLength": 180},
                "competing_senses": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"type": "string", "minLength": 1, "maxLength": 160}
                },
                "translation_constraint": {"type": "string", "minLength": 1, "maxLength": 180},
                "research_trigger": {
                  "type": "string",
                  "enum": ["mpi_missing", "mpi_conflict", "context_ambiguity", "high_risk", "model_uncertain"]
                },
                "external_research_required": {"type": "boolean", "const": true},
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"]
                },
                "notes": {"type": "string", "maxLength": 160}
              }
            }
          },
          "competing_interpretations": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "interpretation",
                "supporting_evidence",
                "counterevidence",
                "evidence_status"
              ],
              "properties": {
                "interpretation": {"type": "string", "minLength": 1, "maxLength": 160},
                "supporting_evidence": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"type": "string", "minLength": 1, "maxLength": 160}
                },
                "counterevidence": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"type": "string", "minLength": 1, "maxLength": 160}
                },
                "evidence_status": {
                  "type": "string",
                  "enum": ["explicit", "contextual_inference", "ambiguous"]
                }
              }
            }
          },
          "must_preserve": {
            "type": "array",
            "maxItems": 16,
            "items": {"type": "string", "minLength": 1, "maxLength": 160}
          },
          "must_not_invent": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 160}
          },
          "status": {"type": "string", "enum": ["clear", "needs_human"]}
        }
      }
    }
  }
}
